# ─────────────────────────────────────────────
# Dossier - Environment Variables
# Copy to .env (development) / .env.production (production).
# All variables are read ONLY in src/lib/env.ts through a Zod schema;
# the app refuses to boot when required variables are missing or invalid.
# ─────────────────────────────────────────────

# ── Core ──
# development | production | test
NODE_ENV=development
# Port the app listens on
PORT=3000
# Public base URL, no trailing slash. Used in emails and QR codes.
APP_URL=http://localhost:3000
# Secret used for HMAC of tokens. At least 32 random bytes hex (64 hex chars).
# Generate: openssl rand -hex 32
APP_SECRET=

# ── Storage ──
# Base directory holding dossier.sqlite, files/, backups/
DATA_DIR=./data
# Optional override of the SQLite database path (defaults to ${DATA_DIR}/dossier.sqlite)
# DATABASE_PATH=

# ── Locale ──
# ar | en
DEFAULT_LOCALE=ar

# ── Email (SMTP) — required in production ──
SMTP_HOST=
SMTP_PORT=587
# true for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# e.g. Dossier <no-reply@example.com>
SMTP_FROM=

# ── Bootstrap (first run only; used by `npm run seed` when there are zero users) ──
# Password must be at least 12 characters.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=

# ── PDF engine ──
PDF_TIMEOUT_MS=30000
PDF_CONCURRENCY=2

# ── Backups ──
BACKUP_RETENTION_DAYS=30

# ── task-board integration (Phase 4 optional) ──
# TASKBOARD_API_URL=
# TASKBOARD_API_TOKEN=

# ── Timezone ──
# The Node process stays on UTC; business timezone lives in Settings.
TZ=UTC
