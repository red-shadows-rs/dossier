# ─────────────────────────────────────────────
# Dossier - Environment Variables
# ─────────────────────────────────────────────

# ── Overview ──
# Copy to .env (development) or .env.production (production).
# All variables are validated in src/lib/env.ts through a Zod schema.

# ── Core ──
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_SECRET=

# ── Storage ──
DATA_DIR=./data
# DATABASE_PATH=

# ── Locale ──
DEFAULT_LOCALE=ar

# ── Email (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Bootstrap ──
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=

# ── PDF Engine ──
PDF_TIMEOUT_MS=30000
PDF_CONCURRENCY=2

# ── Backups ──
BACKUP_RETENTION_DAYS=30

# ── Taskboard Integration ──
# TASKBOARD_API_URL=
# TASKBOARD_API_TOKEN=

# ── Timezone ──
TZ=UTC
